{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "types": [],
    "skipLibCheck": false,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
