{
  "name": "@jirawatpyk/aura-react",
  "version": "4.5.1",
  "description": "AURA Design System — React components (Enterprise Standard, Human Creative). Thai-first: Buddhist-era dates, Thai collation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./aura.bundle.js": "./dist/aura.bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/aura-theme.mjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/sync-bundle.mjs",
    "test:ssr": "node scripts/ssr-test.mjs",
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "examples": "node examples/build.mjs",
    "themes": "node scripts/test-themes.mjs",
    "test:pilots": "npm run examples && npm run themes && python3 tests/pilot_test.py && python3 tests/pilots_test.py",
    "theme": "node scripts/aura-theme.mjs",
    "prepack": "npm run build",
    "pretest:ssr": "node scripts/build.mjs",
    "prethemes": "node scripts/build.mjs",
    "test:hydrate": "node scripts/hydrate-test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.10.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "typescript": "^5.6.0",
    "@playwright/test": "^1.45.0"
  },
  "bin": {
    "aura-theme": "scripts/aura-theme.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jirawatpyk/Aura-design.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Jirawatpyk/Aura-design#readme",
  "bugs": {
    "url": "https://github.com/Jirawatpyk/Aura-design/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "thai",
    "tailwind",
    "accessibility"
  ]
}
