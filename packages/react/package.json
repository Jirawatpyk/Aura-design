{
  "name": "@jirawatpyk/aura-react",
  "version": "5.7.1",
  "description": "AURA Design System — React components (Enterprise Standard, Human Creative). Thai-first: Buddhist-era dates, Thai collation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./aura.bundle.js": "./dist/aura.bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/aura-theme.mjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./dist/aura.bundle.js"
  ],
  "scripts": {
    "build": "node scripts/build.ts && node scripts/sync-bundle.ts",
    "test:ssr": "node scripts/ssr-test.ts && node --conditions=react-server scripts/server-entry-test.ts",
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json && tsc -p tsconfig.exact.json && tsc -p examples/tsconfig.json",
    "examples": "node examples/build.ts",
    "themes": "node scripts/test-themes.ts",
    "test:pilots": "npm run examples && npm run themes && playwright test -c tests/playwright.config.ts",
    "theme": "node scripts/aura-theme.mjs",
    "prepack": "npm run build",
    "pretest:ssr": "node scripts/build.ts",
    "prethemes": "node scripts/build.ts",
    "test:hydrate": "node scripts/hydrate-test.ts",
    "size": "node scripts/size-check.ts",
    "preexamples": "node scripts/build.ts",
    "test:layout": "node scripts/layout-test.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.10.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "typescript": "^5.8.0",
    "@playwright/test": "^1.45.0"
  },
  "bin": {
    "aura-theme": "scripts/aura-theme.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jirawatpyk/Aura-design.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Jirawatpyk/Aura-design#readme",
  "bugs": {
    "url": "https://github.com/Jirawatpyk/Aura-design/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "thai",
    "tailwind",
    "accessibility"
  ]
}
