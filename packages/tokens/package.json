{
  "name": "@jirawatpyk/aura-tokens",
  "version": "4.15.0",
  "description": "AURA Design System — tokens (CSS variables, Tailwind preset, Figma variables), theme contrast checks and token lint.",
  "main": "tailwind.tokens.cjs",
  "types": "components/index.d.ts",
  "files": [
    "tokens.json",
    "aura.css",
    "aura-fonts.css",
    "aura-fonts.local.css",
    "fonts",
    "tailwind.config.ts",
    "tailwind.tokens.cjs",
    "aura-tailwind.css",
    "figma-variables.csv",
    "eslint-plugin-aura.js",
    "components/aura.bundle.js",
    "components/aura.components.css",
    "components/index.d.ts",
    "scripts/a11y-check.js",
    "scripts/lint-tokens.js",
    "GOVERNANCE.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./aura.css": "./aura.css",
    "./aura-fonts.css": "./aura-fonts.css",
    "./aura-fonts.local.css": "./aura-fonts.local.css",
    "./fonts/*": "./fonts/*",
    "./tokens.json": "./tokens.json",
    "./tailwind": "./tailwind.tokens.cjs",
    "./tailwind.css": "./aura-tailwind.css",
    "./components.js": "./components/aura.bundle.js",
    "./components.css": "./components/aura.components.css",
    "./eslint-plugin": "./eslint-plugin-aura.js"
  },
  "scripts": {
    "build": "node scripts/build-tokens.js",
    "a11y": "node scripts/a11y-check.js",
    "check:tailwind4": "node scripts/tailwind4-check.mjs",
    "lint:tokens": "node scripts/lint-tokens.js ../react/src && node scripts/lint-tokens.js ../react/styles",
    "check:generated": "node scripts/build-tokens.js && git diff --exit-code -- aura.css aura-fonts.css aura-fonts.local.css tailwind.tokens.cjs aura-tailwind.css figma-variables.csv",
    "prepack": "npm run build",
    "check:fonts": "node scripts/fonts-check.mjs"
  },
  "keywords": [
    "design-system",
    "tokens",
    "enterprise",
    "tailwind",
    "figma",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jirawatpyk/Aura-design.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Jirawatpyk/Aura-design#readme",
  "bugs": {
    "url": "https://github.com/Jirawatpyk/Aura-design/issues"
  }
}
