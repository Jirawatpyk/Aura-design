{
  "name": "@jirawatpyk/aura-storybook",
  "private": true,
  "version": "4.4.2",
  "description": "AURA Design System \u2014 Storybook, visual regression (Chromatic) and accessibility checks",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --disable-telemetry",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "lint:tokens": "node ../../packages/tokens/scripts/lint-tokens.js stories",
    "a11y": "node ../../packages/tokens/scripts/a11y-check.js",
    "a11y:ci": "playwright test --config=playwright.a11y.config.ts",
    "telemetry": "node scripts/telemetry.js",
    "test:components": "playwright test --config=playwright.components.config.ts",
    "test": "npm run build-storybook && npm run a11y:ci && npm run test:components"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@chromatic-com/storybook": "^3.2.0",
    "@playwright/test": "^1.45.0",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "axe-core": "^4.10.0",
    "http-server": "^14.1.1",
    "react-hook-form": "^7.88.0",
    "storybook": "^8.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/manager-api": "^8.6.0",
    "@storybook/theming": "^8.6.0"
  }
}
